#110 0 0001 (acc is set, ard eval set, wh en not set, address 5)
#101 11010 //other wh bits set, address is 26
#0000 //filler
symbol WH_EN @2;
symbol WH_COM @8;
symbol WH_DIR @9;
symbol WH_SEL @10;
symbol ACC @0;
#1 00001 //reset adr eval(not needed in HRAC)
#set whcom whsel
NAW WH_COM
NAW WH_SEL
#1 00010 // set wh en
NAW WH_EN