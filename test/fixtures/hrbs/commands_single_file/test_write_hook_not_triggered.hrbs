MAIN:
	symbol WH_EN @2;
	symbol WH_COM @8;
	symbol WH_DIR @9;
	symbol WH_SEL @10;
	SET1 WH_COM;
	SET1 WH_DIR;
	SET1 WH_SEL;

SET0:
	shared alloc H
	symbol ACC @0;
	NAW H;
	NAR ACC;
	NAW H;
	NAR H;
	
SET1 A:
	SET0;
	WRITE1 A;
	
WRITE1 A:
	NAW A;
	INV0;
	NAW A;
	INV0;
	
INV0:
	symbol ACC @0;
	NAR ACC;